          },
          "password": {
            "type": "string",
            "example": "12345678"
          },
          "confirmPassword": {
            "type": "string",
            "example": "12345678"
          }
        },
        "xml": {
          "name": "RegisterRequest"
        }
      },
      "ActivationRequest": {
        "type": "object",
        "properties": {
